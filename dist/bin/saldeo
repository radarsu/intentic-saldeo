const labelled = (cells, ...labels) => {
  for (const cell of cells) {
    const colon = cell.indexOf(":");
    if (colon < 0) {
      continue;
    }
    const label = fold(cell.slice(0, colon)).trim();
    if (labels.some((wanted) => label === fold(wanted))) {
      const value = cell.slice(colon + 1).trim();
      if (value !== "") {
        return value;
      }
    }
  }
  return void 0;
};
