const SAFE_SEGMENT = /^[a-z0-9][a-z0-9-]*$/;
const safe = (segment, what) => {
  if (!SAFE_SEGMENT.test(segment)) {
    throw new Error(`${what} "${segment}" is not a safe path segment`);
  }
  return segment;
};
const saldeoRoot = (workspaceRoot) => join(workspaceRoot, ...RECORDS);
