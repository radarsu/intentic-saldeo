const operationOf = (node) => {
  const value = Math.abs(saldeoAmount(text(node, "VALUE")));
  const debit = text(node, "DEBIT_CREDIT") === "DEBIT";
  const matching = at(node, "SALDEOSMART_MATCHING", "CONTRACTOR");
